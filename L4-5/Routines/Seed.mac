ROUTINE Seed
  Do ##class(User.Student).%KillExtent()
  Do ##class(User.Course).%KillExtent()
  Do ##class(User.Teacher).%KillExtent()

  Write !, "Generating Teachers: ", ##class(User.Teacher).Populate(5, 1)
  Write !, "Generating Courses: ", ##class(User.Course).Populate(10, 1)
  Write !, "Generating Students: ", ##class(User.Student).Populate(25, 1)

  Write !, "Database has been successfully populated!"
  Quit
