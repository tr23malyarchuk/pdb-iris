ROUTINE Seed
    Do ##class(User.Student).%KillExtent()
    Do ##class(User.Course).%KillExtent()
    Do ##class(User.Teacher).%KillExtent()

    Set teacher1 = ##class(User.Teacher).%New()
    Set teacher1.FullName = "Коваленко Олена Петрівна"
    Set teacher1.Info.Degree = "Доцент"
    Set teacher1.Info.Position = "Старший викладач"
    Do teacher1.TargetGroups.Insert("КН-301")

    Set course1 = ##class(User.Course).%New()
    Set course1.Title = "Databases"
    Set course1.ControlType = "Экзамен"
    Set course1.Teacher = teacher1
    Do course1.ExtraNotes.SetAt("Лабораторні роботи обов'язкові", "n1")
    Do course1.%Save()

    Set teacher2 = ##class(User.Teacher).%New()
    Set teacher2.FullName = "Шевченко Андрій Миколайович"
    Set teacher2.Info.Degree = "Професор"
    Set teacher2.Info.Position = "Завідувач кафедри"
    Do teacher2.TargetGroups.Insert("ІП-302")

    Set course2 = ##class(User.Course).%New()
    Set course2.Title = "Object Databases"
    Set course2.ControlType = "Зачет"
    Set course2.Teacher = teacher2
    Do course2.ExtraNotes.SetAt("Захист практикуму обов'язковий", "n1")
    Do course2.%Save()

    Set student1 = ##class(User.Student).%New()
    Set student1.FullName = "Іваненко Іван Іванович"
    Set student1.Course = course1
    Set student1.Rating1 = 45
    Set student1.Rating2 = 48
    
    Set info1 = ##class(User.StudentInfo).%New()
    Set info1.GroupNumber = "КН-301"
    Set info1.Specialty = "Computer Science"
    Set info1.Status = "Учится"
    Set student1.Info = info1
    
    Do student1.BioPhoto.Write("Photo_Data_Ivanenko")
    Do student1.%Save()

    Set student2 = ##class(User.Student).%New()
    Set student2.FullName = "Петренко Петро Петрович"
    Set student2.Course = course2
    Set student2.Rating1 = 38
    Set student2.Rating2 = 42
    
    Set info2 = ##class(User.StudentInfo).%New()
    Set info2.GroupNumber = "ІП-302"
    Set info2.Specialty = "Software Engineering"
    Set info2.Status = "Академ"
    Set student2.Info = info2
    
    Do student2.BioPhoto.Write("Photo_Data_Petrenko")
    Do student2.%Save()

    Write !, "База данных успешно заполнена!"
    Quit
