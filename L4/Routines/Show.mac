ROUTINE Show
    Write !!, "--- СПИСОК КУРСОВ ---"
    Set id = ""
    For {
        Set id = $Order(^User.CourseD(id))
        Quit:id=""
        
        Set course = ##class(User.Course).%OpenId(id)
        Write !, "Курс #", id, ": ", course.Title, " (", course.ControlType, ")"
        If course.Teacher'="" {
            Write " | Преподаватель: ", course.Teacher.FullName
        }
    }

    Write !!, "--- СПИСОК СТУДЕНТОВ ---"
    Set id = ""
    For {
        Set id = $Order(^User.StudentD(id))
        Quit:id=""
        
        Set student = ##class(User.Student).%OpenId(id)
        Write !, "Студент: ", student.FullName
        Write " | Группа: ", student.Info.GroupNumber
        Write " | Общий рейтинг: ", student.TotalRating
        If student.Course'="" {
            Write " | Записан на курс: ", student.Course.Title
        }
    }

    Write !!, "--- СПИСОК ПРЕПОДАВАТЕЛЕЙ ---"
    Set id = ""
    For {
        Set id = $Order(^User.TeacherD(id))
        Quit:id=""
        
        Set teacher = ##class(User.Teacher).%OpenId(id)
        Write !, "Преподаватель: ", teacher.FullName
        Write " | Должность: ", teacher.Info.Position
        Write " | Всего курсов ведет: ", teacher.Courses.Count()
    }
    
    Write !
    Quit
